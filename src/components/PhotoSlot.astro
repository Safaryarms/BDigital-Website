---
import { PHOTOS } from '../config';

interface Props {
  id: string;
  placeholder: string;
}
const { id, placeholder } = Astro.props;
const photo = PHOTOS[id];
---
{photo?.src ? (
  <img src={photo.src} alt={photo.alt} loading={id === 'hero-photo' ? 'eager' : 'lazy'} style="display:block;width:100%;height:100%;object-fit:cover" />
) : (
  <div class="photo-slot" role="img" aria-label={photo?.alt ?? placeholder}>
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5"></rect><circle cx="9" cy="10" r="1.8"></circle><path d="M21 16l-5-5-8 8"></path></svg>
    <span>{placeholder}</span>
  </div>
)}
