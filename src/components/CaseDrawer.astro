---
// Case-drawer (homepage). Kaarten met data-case="N" openen de bijbehorende drawer.
// Cases zijn voorbeelden; de 10-stappenstructuur wordt per case ingevuld.
const CASES = [
  { name: 'Leadopvolging B2B-dienstverlener', num: '+2,4x', label: 'snellere opvolging', bg: '#FFB8D9', fg: '#0B0B0B' },
  { name: 'Maandrapportage marketingteam', num: '−55%', label: 'rapportagetijd', bg: '#C5FF27', fg: '#0B0B0B' },
  { name: 'Klantintake zorgorganisatie', num: '−60%', label: 'handmatige overdrachten', bg: '#CBB8FF', fg: '#0B0B0B' },
  { name: 'Offertevoorbereiding installateur', num: '+30%', label: 'first-time-right', bg: '#0B0B0B', fg: '#FFFFFF' },
];
const CASE_STEPS = ['De uitgangssituatie', 'Het gekozen proces', 'De nulmeting', 'De gebruikte data en systemen', 'Wat is geautomatiseerd', 'Waar mensen blijven controleren', 'Het gemeten resultaat', 'De benodigde correcties en uitzonderingen', 'Wat aan de klant is overgedragen', 'Beperkingen van de meting'];
---
<div class="case-drawer" data-case-drawer hidden>
  <div data-case-close style="position:fixed;inset:0;background:rgba(11,11,11,.72);z-index:80"></div>
  {CASES.map((c, i) => (
    <aside data-case-panel={i} role="dialog" aria-modal="true" aria-label={c.name} tabindex="-1" hidden style="position:fixed;top:0;right:0;bottom:0;width:min(560px,100%);background:#F4F1EA;z-index:81;overflow-y:auto;flex-direction:column">
      <div style={`background:${c.bg};color:${c.fg};padding:28px 28px 32px;display:flex;flex-direction:column;gap:14px`}>
        <div style="display:flex;justify-content:space-between;align-items:center"><span style="font-size:11px;font-weight:800;letter-spacing:.16em;text-transform:uppercase">Case</span><button type="button" data-case-close aria-label="Sluiten" style="width:40px;height:40px;border-radius:50%;border:1.5px solid currentColor;background:transparent;color:inherit;font-size:18px;cursor:pointer">✕</button></div>
        <h3 style="margin:0;font-size:28px;font-weight:800;line-height:1.1;letter-spacing:-.02em">{c.name}</h3>
        <div style="display:flex;align-items:baseline;gap:12px"><span style="font-size:48px;font-weight:800;letter-spacing:-.04em">{c.num}</span><span style="font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase">{c.label}</span></div>
      </div>
      <ol style="list-style:none;margin:0;padding:12px 28px 40px">
        {CASE_STEPS.map((t, n) => (
          <li style="display:flex;gap:16px;padding:16px 0;border-bottom:1px solid #DDD8CC"><span style="flex:none;width:32px;height:32px;border-radius:50%;border:1.5px solid #0B0B0B;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:800">{n + 1}</span><div style="display:flex;flex-direction:column;gap:4px"><span style="font-size:16px;font-weight:800">{t}</span><span style="font-size:14px;color:#6B6A64">Wordt per case ingevuld.</span></div></li>
        ))}
      </ol>
    </aside>
  ))}
</div>
