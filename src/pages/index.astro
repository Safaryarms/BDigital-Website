---
import Layout from '../layouts/Layout.astro';
import GhlFormEmbed from '../components/GhlFormEmbed.astro';
import Badge from '../components/Badge.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
---
<Layout title="BDigital — Online groei agency" description="BDigital is een online groei agency: strategie, creatie, marketing en automatisering in één meetbaar groeiproces, van eerste indruk tot klant." page="home">
<section data-screen-label="01 Hero" style="background:#0B0B0B;color:#fff;position:relative;overflow:hidden">
  <div style="max-width:1240px;margin:0 auto;padding:clamp(48px,7vw,96px) clamp(20px,4vw,48px) clamp(56px,8vw,110px);display:flex;flex-wrap:wrap;gap:clamp(40px,5vw,72px);align-items:center">
    <div style="flex:1 1 440px;min-width:0;display:flex;flex-direction:column;gap:26px">
      <span style="align-self:flex-start;display:inline-flex;align-items:center;gap:10px;padding:7px 14px;border:1.5px solid #C5FF27;color:#C5FF27;border-radius:999px;font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;white-space:nowrap"><span style="width:7px;height:7px;border-radius:50%;background:#C5FF27"></span>Online groei agency</span>
      <h1 lang="nl" style="margin:0;font-size:clamp(46px,7vw,100px);line-height:.92;font-weight:800;letter-spacing:-.035em;text-transform:uppercase">Merken die sneller <span style="color:#C5FF27">groeien.</span></h1>
      <p style="margin:0;font-size:18px;line-height:1.6;color:#C9C9C2;max-width:560px;text-wrap:pretty">Strategie, creativiteit en technologie voor maximale online groei. We bouwen jouw marketing uit tot één meetbaar groeiproces: van eerste indruk tot klant.</p>
      <div style="display:flex;flex-wrap:wrap;gap:14px;align-items:center">
        <a class="h0" href="#intake" style="display:inline-flex;align-items:center;gap:10px;background:#C5FF27;color:#0B0B0B;font-weight:700;font-size:15px;padding:16px 24px;border-radius:999px;transition:transform .2s;white-space:nowrap">Start je project <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"></path></svg></a>
        <a class="h1" href="#cases" style="display:inline-flex;align-items:center;gap:10px;color:#fff;font-weight:700;font-size:15px;padding:15px 22px;border-radius:999px;border:1.5px solid #4A4A4A;transition:border-color .2s;white-space:nowrap">Bekijk onze cases</a>
      </div>
      <p style="margin:0;font-size:14px;color:#9E9E97;font-weight:500">Jouw data, jouw accounts en jouw proceskennis.</p>
    </div>
    <div style="flex:1 1 400px;min-width:0;position:relative;height:clamp(460px,48vw,600px)">
      <div style="position:absolute;left:4%;right:2%;top:10%;bottom:2%;background:#CBB8FF;border-radius:46% 54% 42% 58% / 52% 38% 62% 48%"></div>
      <div style="position:absolute;left:20%;right:12%;top:0;bottom:0;border-radius:220px 220px 28px 28px;overflow:hidden">
        <PhotoSlot id="hero-photo" placeholder="Foto: echte persoon aan het werk (uitgesneden PNG werkt het best)" />
      </div>
      <div style="position:absolute;top:10%;left:0;width:200px;background:#fff;color:#0B0B0B;border-radius:16px;padding:14px 16px;box-shadow:0 20px 40px rgba(0,0,0,.35);display:flex;flex-direction:column;gap:4px">
        <span style="font-size:12px;font-weight:600;color:#55544E">Leadopvolging</span>
        <div style="display:flex;align-items:center;justify-content:space-between"><span data-count="3" data-suf="x" style="font-size:30px;font-weight:800;letter-spacing:-.03em">3x</span><span style="width:26px;height:26px;border-radius:50%;background:#C5FF27;display:flex;align-items:center;justify-content:center"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#0B0B0B" stroke-width="2.6" stroke-linecap="round"><path d="M7 7l10 10M17 8v9H8"></path></svg></span></div>
        <span style="font-size:11px;color:#55544E">t.o.v. nulmeting</span>
        <svg viewBox="0 0 160 34" width="100%" height="30" fill="none" stroke="#0B0B0B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="2,30 26,26 48,27 70,18 94,20 116,11 138,12 158,4"></polyline></svg>
      </div>
      <div style="position:absolute;bottom:24%;right:0;width:200px;background:#fff;color:#0B0B0B;border-radius:16px;padding:14px 16px;box-shadow:0 20px 40px rgba(0,0,0,.35);display:flex;flex-direction:column;gap:4px">
        <span style="font-size:12px;font-weight:600;color:#55544E">Tijd tot opvolging</span>
        <div style="display:flex;align-items:center;justify-content:space-between"><span data-count="65" data-pre="−" data-suf="%" style="font-size:30px;font-weight:800;letter-spacing:-.03em">−65%</span><span style="width:26px;height:26px;border-radius:50%;background:#C5FF27;display:flex;align-items:center;justify-content:center"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#0B0B0B" stroke-width="2.6" stroke-linecap="round"><path d="M7 7l10 10M17 8v9H8"></path></svg></span></div>
        <span style="font-size:11px;color:#55544E">t.o.v. nulmeting</span>
        <svg viewBox="0 0 160 34" width="100%" height="30" fill="none" stroke="#0B0B0B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="2,4 24,6 46,14 68,12 92,22 114,26 136,28 158,31"></polyline></svg>
      </div>
      <div style="position:absolute;bottom:3%;left:2%;right:16%;max-width:390px;background:#141414;border:1px solid #2E2E2E;border-radius:16px;padding:12px 14px;box-shadow:0 20px 40px rgba(0,0,0,.4);display:flex;flex-wrap:wrap;align-items:center;gap:6px;font-size:12px;font-weight:600;color:#E8E8E3">
        <span style="padding:5px 9px;border-radius:999px;border:1px solid #3A3A3A">Campagne</span><span style="color:#C5FF27">→</span>
        <span style="padding:5px 9px;border-radius:999px;border:1px solid #3A3A3A">Lead</span><span style="color:#C5FF27">→</span>
        <span style="padding:5px 9px;border-radius:999px;border:1px solid #3A3A3A">CRM</span><span style="color:#C5FF27">→</span>
        <span style="padding:5px 9px;border-radius:999px;background:#FFB8D9;color:#0B0B0B">Opvolging ✓</span>
      </div>
    </div>
  </div>
  <div class="only-wide">
    <div aria-hidden="true" style="position:absolute;right:22px;top:50%;transform:translateY(-50%) rotate(180deg);writing-mode:vertical-rl;font-size:11px;font-weight:700;letter-spacing:.3em;text-transform:uppercase;color:#8A8A84;display:flex;align-items:center;gap:14px">Content die verbindt<span style="width:1px;height:48px;background:#3A3A3A"></span></div>
  </div>
</section>

<section data-screen-label="02 Herkenbaar" style="background:#F4F1EA;padding:clamp(64px,9vw,120px) 0">
  <div style="max-width:1240px;margin:0 auto;padding:0 clamp(20px,4vw,48px);display:flex;flex-wrap:wrap;gap:clamp(32px,5vw,72px);align-items:center">
    <div style="flex:1 1 380px;min-width:0;display:flex;flex-direction:column;gap:20px">
      <span style="display:inline-flex;align-self:flex-start;padding:6px 12px;border-radius:999px;background:#CBB8FF;color:#0B0B0B;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;;white-space:nowrap">Herkenbaar?</span>
      <h2 style="margin:0;font-size:clamp(30px,4vw,52px);font-weight:800;line-height:1.04;letter-spacing:-.03em;text-wrap:balance;">Veel marketing, maar weinig grip op <span style="background:linear-gradient(transparent 58%, #C5FF27 58%, #C5FF27 94%, transparent 94%);padding:0 .08em;-webkit-box-decoration-break:clone;box-decoration-break:clone">groei?</span></h2>
      <p style="margin:0;font-size:17px;line-height:1.65;color:#3E3D39;max-width:540px;text-wrap:pretty">Veel organisaties hebben een website, CRM, advertenties, dashboards en verschillende marketingtools. Toch blijft de uitvoering afhankelijk van spreadsheets, handmatige overdrachten en mensen die precies weten hoe alles werkt. Data staan verspreid, opvolging raakt verloren en het is moeilijk vast te stellen welke activiteiten werkelijk waarde toevoegen.</p>
      <p style="margin:4px 0 0;font-size:clamp(18px,2vw,21px);font-weight:700;line-height:1.4;text-wrap:pretty">Van losse marketingactiviteiten naar één meetbaar groeiproces.</p>
    </div>
    <ul style="flex:1 1 380px;min-width:0;list-style:none;margin:0;padding:8px 28px;background:#fff;border-radius:20px;border:1px solid #E4E0D6">
      <li style="display:flex;gap:14px;padding:16px 0;border-bottom:1px solid #EEEAE1;font-size:16px;line-height:1.45;font-weight:500"><span style="flex:none;width:22px;height:22px;border-radius:6px;border:1.5px solid #0B0B0B;display:flex;align-items:center;justify-content:center;margin-top:1px"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#0B0B0B" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10"></path></svg></span>Leads worden niet consequent opgevolgd.</li>
      <li style="display:flex;gap:14px;padding:16px 0;border-bottom:1px solid #EEEAE1;font-size:16px;line-height:1.45;font-weight:500"><span style="flex:none;width:22px;height:22px;border-radius:6px;border:1.5px solid #0B0B0B;display:flex;align-items:center;justify-content:center;margin-top:1px"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#0B0B0B" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10"></path></svg></span>Campagnes en CRM-data sluiten onvoldoende op elkaar aan.</li>
      <li style="display:flex;gap:14px;padding:16px 0;border-bottom:1px solid #EEEAE1;font-size:16px;line-height:1.45;font-weight:500"><span style="flex:none;width:22px;height:22px;border-radius:6px;border:1.5px solid #0B0B0B;display:flex;align-items:center;justify-content:center;margin-top:1px"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#0B0B0B" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10"></path></svg></span>Rapportages kosten iedere maand opnieuw veel handwerk.</li>
      <li style="display:flex;gap:14px;padding:16px 0;border-bottom:1px solid #EEEAE1;font-size:16px;line-height:1.45;font-weight:500"><span style="flex:none;width:22px;height:22px;border-radius:6px;border:1.5px solid #0B0B0B;display:flex;align-items:center;justify-content:center;margin-top:1px"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#0B0B0B" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10"></path></svg></span>Klantdata staan verspreid over verschillende systemen.</li>
      <li style="display:flex;gap:14px;padding:16px 0;font-size:16px;line-height:1.45;font-weight:500"><span style="flex:none;width:22px;height:22px;border-radius:6px;border:1.5px solid #0B0B0B;display:flex;align-items:center;justify-content:center;margin-top:1px"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#0B0B0B" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10"></path></svg></span>Resultaten worden gemeten zonder betrouwbare nulmeting.</li>
    </ul>
  </div>
</section>

<section id="diensten" data-screen-label="03 Diensten" style="background:#F4F1EA;padding:0 0 clamp(64px,9vw,120px);scroll-margin-top:70px">
  <div style="max-width:1240px;margin:0 auto;padding:0 clamp(20px,4vw,48px)">
    <div style="padding-top:clamp(56px,7vw,96px);border-top:1px solid #DDD8CC;display:flex;flex-wrap:wrap;gap:24px 48px;align-items:flex-end;justify-content:space-between">
      <div style="flex:1 1 520px;min-width:0;display:flex;flex-direction:column;gap:18px"><span style="display:inline-flex;align-self:flex-start;padding:6px 12px;border-radius:999px;background:#0B0B0B;color:#fff;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;;white-space:nowrap">Wat we doen</span><h2 style="margin:0;font-size:clamp(30px,4vw,52px);font-weight:800;line-height:1.04;letter-spacing:-.03em;text-wrap:balance;max-width:760px">Marketing, data en automation als één geheel.</h2></div>
      <p style="flex:1 1 340px;margin:0;font-size:17px;line-height:1.65;color:#3E3D39;max-width:460px;text-wrap:pretty">We ontwerpen geen verzameling losse oplossingen. We bouwen een samenhangend proces waarin strategie, creatie, data, uitvoering, controle en meting op elkaar aansluiten.</p>
    </div>
    <div style="margin-top:clamp(36px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:16px">
      <article class="h2" style="background:#fff;color:#0B0B0B;border:1px solid #E4E0D6;border-radius:20px;padding:26px;display:flex;flex-direction:column;gap:14px;min-height:360px;transition:transform .25s,box-shadow .25s"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 20V13M10 20V8M15 20V11M20 20V4"></path></svg><h3 style="margin:10px 0 0;font-size:24px;font-weight:800;line-height:1.1;letter-spacing:-.02em">Strategie</h3><p style="margin:0;font-size:16px;line-height:1.5;font-weight:600">Een helder plan voor duurzame groei.</p><ul style="margin:0;padding:0 0 0 18px;font-size:15px;line-height:1.75"><li>positionering en propositie</li><li>klantreis en doelgroepen</li><li>groeiplan met meetpunten</li></ul><a class="h3" href="#intake" aria-label="Meer over Strategie" style="margin-top:auto;align-self:flex-start;width:46px;height:46px;border-radius:50%;background:#0B0B0B;color:#fff;display:flex;align-items:center;justify-content:center;transition:transform .2s"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"></path></svg></a></article>
      <article class="h2" style="background:#C5FF27;color:#0B0B0B;border:none;border-radius:20px;padding:26px;display:flex;flex-direction:column;gap:14px;min-height:360px;transition:transform .25s,box-shadow .25s"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10v4h3l6 4V6L7 10z"></path><path d="M16.5 9a4 4 0 0 1 0 6"></path></svg><h3 style="margin:10px 0 0;font-size:24px;font-weight:800;line-height:1.1;letter-spacing:-.02em">Adverteren</h3><p style="margin:0;font-size:16px;line-height:1.5;font-weight:600">Meer bereik, meer leads, meer resultaat.</p><ul style="margin:0;padding:0 0 0 18px;font-size:15px;line-height:1.75"><li>campagnes op social en search</li><li>content en creatie</li><li>kanaaladaptatie en testen</li></ul><a class="h3" href="#intake" aria-label="Meer over Adverteren" style="margin-top:auto;align-self:flex-start;width:46px;height:46px;border-radius:50%;background:#fff;color:#0B0B0B;display:flex;align-items:center;justify-content:center;transition:transform .2s"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"></path></svg></a></article>
      <article class="h2" style="background:#CBB8FF;color:#0B0B0B;border:none;border-radius:20px;padding:26px;display:flex;flex-direction:column;gap:14px;min-height:360px;transition:transform .25s,box-shadow .25s"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"></path><path d="M4 7.5l8 4.5 8-4.5M12 12v9"></path></svg><h3 style="margin:10px 0 0;font-size:24px;font-weight:800;line-height:1.1;letter-spacing:-.02em">Websites &amp; funnels</h3><p style="margin:0;font-size:16px;line-height:1.5;font-weight:600">Van idee tot een converterende website.</p><ul style="margin:0;padding:0 0 0 18px;font-size:15px;line-height:1.75"><li>websites en landingspagina’s</li><li>funnels en leadverwerking</li><li>koppeling met je CRM</li></ul><a class="h3" href="#intake" aria-label="Meer over Websites &amp; funnels" style="margin-top:auto;align-self:flex-start;width:46px;height:46px;border-radius:50%;background:#fff;color:#0B0B0B;display:flex;align-items:center;justify-content:center;transition:transform .2s"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"></path></svg></a></article>
      <article class="h2" style="background:#0B0B0B;color:#fff;border:none;border-radius:20px;padding:26px;display:flex;flex-direction:column;gap:14px;min-height:360px;transition:transform .25s,box-shadow .25s"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12a8 8 0 1 1-2.6-5.9L20 8.5"></path><path d="M20 3.5v5h-5"></path></svg><h3 style="margin:10px 0 0;font-size:24px;font-weight:800;line-height:1.1;letter-spacing:-.02em">Data &amp; automation</h3><p style="margin:0;font-size:16px;line-height:1.5;font-weight:600">Van terugkerend handwerk naar een beheersbare workflow.</p><ul style="margin:0;padding:0 0 0 18px;font-size:15px;line-height:1.75"><li>dashboards en rapportage</li><li>opvolging en workflows</li><li>koppelingen tussen je tools</li></ul><a class="h3" href="#intake" aria-label="Meer over Data &amp; automation" style="margin-top:auto;align-self:flex-start;width:46px;height:46px;border-radius:50%;background:#C5FF27;color:#0B0B0B;display:flex;align-items:center;justify-content:center;transition:transform .2s"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"></path></svg></a></article>
    </div>
  </div>
</section>

<section data-screen-label="04 Resultaten" style="background:#0B0B0B;color:#fff;padding:clamp(48px,6vw,72px) 0">
  <div style="max-width:1240px;margin:0 auto;padding:0 clamp(20px,4vw,48px);display:flex;flex-wrap:wrap;gap:40px;align-items:center">
    <div style="flex:1 1 260px;display:flex;flex-direction:column;align-items:flex-start;gap:16px">
      <span style="display:inline-flex;padding:6px 12px;border-radius:999px;border:1.5px solid #fff;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;white-space:nowrap">De resultaten</span>
      <h2 style="margin:0;font-size:clamp(26px,2.8vw,36px);font-weight:800;line-height:1.08;letter-spacing:-.025em">Betere processen. <span style="color:#C5FF27">Meetbare groei.</span></h2>
    </div>
    <div style="flex:3 1 620px;min-width:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:24px 0">
      <div style="padding:4px 24px;border-left:1px solid #2E2E2E;display:flex;flex-direction:column;gap:10px"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3.5 2"></path></svg><span data-count="40" data-pre="−" data-suf="%" style="font-size:clamp(38px,4vw,52px);font-weight:800;letter-spacing:-.04em;color:#C5FF27;line-height:1">−40%</span><span style="font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#D6D6D0">minder handmatig werk</span></div>
      <div style="padding:4px 24px;border-left:1px solid #2E2E2E;display:flex;flex-direction:column;gap:10px"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 8-8"></path><path d="M14 7h7v7"></path></svg><span data-count="3" data-suf="x" style="font-size:clamp(38px,4vw,52px);font-weight:800;letter-spacing:-.04em;color:#C5FF27;line-height:1">3x</span><span style="font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#D6D6D0">snellere opvolging van leads</span></div>
      <div style="padding:4px 24px;border-left:1px solid #2E2E2E;display:flex;flex-direction:column;gap:10px"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M8 12.5l3 3 5-6"></path></svg><span data-count="35" data-pre="+" data-suf="%" style="font-size:clamp(38px,4vw,52px);font-weight:800;letter-spacing:-.04em;color:#C5FF27;line-height:1">+35%</span><span style="font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#D6D6D0">meer first-time-right</span></div>
      <div style="padding:4px 24px;border-left:1px solid #2E2E2E;display:flex;flex-direction:column;gap:10px"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round"><rect x="4.5" y="10.5" width="15" height="10" rx="2.5"></rect><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"></path></svg><span data-count="100" data-suf="%" style="font-size:clamp(38px,4vw,52px);font-weight:800;letter-spacing:-.04em;color:#C5FF27;line-height:1">100%</span><span style="font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#D6D6D0">eigenaarschap bij de klant</span></div>
    </div>
  </div>
</section>

