---
import Layout from '../layouts/Layout.astro';
import GhlFormEmbed from '../components/GhlFormEmbed.astro';
import Badge from '../components/Badge.astro';
---
<Layout title="Onze aanpak — BDigital" description="Eerst begrijpen, dan bouwen, blijven verbeteren. De aanpak van BDigital in vijf stappen: van vraagstuk en plan tot uitvoering, meten en opschalen." page="aanpak">
<section data-screen-label="01 Hero aanpak" style="background:#0B0B0B;color:#fff;position:relative;overflow:hidden">
  <div style="max-width:1240px;margin:0 auto;padding:clamp(48px,7vw,96px) clamp(20px,4vw,48px) clamp(64px,8vw,110px);display:flex;flex-wrap:wrap;gap:clamp(40px,5vw,80px);align-items:center">
    <div style="flex:1.2 1 460px;min-width:0;display:flex;flex-direction:column;gap:26px">
      <span style="align-self:flex-start;display:inline-flex;align-items:center;gap:10px;padding:7px 14px;border:1.5px solid #C5FF27;color:#C5FF27;border-radius:999px;font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;white-space:nowrap"><span style="width:7px;height:7px;border-radius:50%;background:#C5FF27"></span>Onze aanpak · Van inzicht naar resultaat</span>
      <h1 lang="nl" style="margin:0;font-size:clamp(42px,6vw,86px);line-height:.95;font-weight:800;letter-spacing:-.035em;text-transform:uppercase;text-wrap:balance">Eerst begrijpen. Dan bouwen. <span style="color:#C5FF27">Blijven verbeteren.</span></h1>
      <p style="margin:0;font-size:17px;line-height:1.65;color:#C9C9C2;text-wrap:pretty;font-size:18px;max-width:560px">Groei begint niet bij een nieuwe campagne, een andere website of de nieuwste tool. Het begint bij begrijpen waar jouw bedrijf kansen laat liggen.</p>
      <div style="display:flex;flex-wrap:wrap;gap:14px;align-items:center"><a class="h0" href="#intake" style="display:inline-flex;align-items:center;gap:10px;background:#C5FF27;color:#0B0B0B;font-weight:700;font-size:15px;padding:16px 24px;border-radius:999px;white-space:nowrap;transition:transform .2s">Plan een kennismaking <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"></path></svg></a><a class="h1" href="#stap-1" style="display:inline-flex;align-items:center;gap:10px;color:#fff;font-weight:700;font-size:15px;padding:15px 22px;border-radius:999px;border:1.5px solid #4A4A4A;white-space:nowrap;transition:border-color .2s">Ontdek onze werkwijze</a></div>
    </div>
    <nav aria-label="Stappen" style="flex:1 1 380px;min-width:0;background:#151515;border:1px solid #2A2A2A;border-radius:24px;padding:clamp(20px,2.5vw,30px);position:relative">
      <span style="position:absolute;left:calc(clamp(20px,2.5vw,30px) + 21px);top:52px;bottom:52px;width:2px;background:linear-gradient(#C5FF27,#CBB8FF,#FFB8D9)"></span>
      <a class="h12" href="#stap-1" style="position:relative;display:flex;align-items:center;gap:16px;padding:12px 8px 12px 0;border-radius:14px;transition:transform .2s"><span style="flex:none;width:44px;height:44px;border-radius:50%;background:#C5FF27;color:#0B0B0B;border:2px solid #C5FF27;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:800">01</span><span style="flex:1;font-size:16px;font-weight:700;line-height:1.3">We brengen het volledige vraagstuk in kaart</span><span style="flex:none;color:#8A8A84"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"></path></svg></span></a>
      <a class="h12" href="#stap-2" style="position:relative;display:flex;align-items:center;gap:16px;padding:12px 8px 12px 0;border-radius:14px;transition:transform .2s"><span style="flex:none;width:44px;height:44px;border-radius:50%;background:#0B0B0B;color:#fff;border:2px solid #D9F58F;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:800">02</span><span style="flex:1;font-size:16px;font-weight:700;line-height:1.3">Drie disciplines. Eén samenhangende aanpak.</span><span style="flex:none;color:#8A8A84"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"></path></svg></span></a>
      <a class="h12" href="#stap-3" style="position:relative;display:flex;align-items:center;gap:16px;padding:12px 8px 12px 0;border-radius:14px;transition:transform .2s"><span style="flex:none;width:44px;height:44px;border-radius:50%;background:#0B0B0B;color:#fff;border:2px solid #CBB8FF;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:800">03</span><span style="flex:1;font-size:16px;font-weight:700;line-height:1.3">We vertalen inzichten naar een concreet plan</span><span style="flex:none;color:#8A8A84"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"></path></svg></span></a>
      <a class="h12" href="#stap-4" style="position:relative;display:flex;align-items:center;gap:16px;padding:12px 8px 12px 0;border-radius:14px;transition:transform .2s"><span style="flex:none;width:44px;height:44px;border-radius:50%;background:#0B0B0B;color:#fff;border:2px solid #E4B8E0;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:800">04</span><span style="flex:1;font-size:16px;font-weight:700;line-height:1.3">Van strategie naar uitvoering</span><span style="flex:none;color:#8A8A84"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"></path></svg></span></a>
      <a class="h12" href="#stap-5" style="position:relative;display:flex;align-items:center;gap:16px;padding:12px 8px 12px 0;border-radius:14px;transition:transform .2s"><span style="flex:none;width:44px;height:44px;border-radius:50%;background:#0B0B0B;color:#fff;border:2px solid #FFB8D9;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:800">05</span><span style="flex:1;font-size:16px;font-weight:700;line-height:1.3">Meten, verbeteren en opschalen</span><span style="flex:none;color:#8A8A84"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"></path></svg></span></a>
    </nav>
  </div>
</section>

<section data-screen-label="02 Introductie" style="background:#F4F1EA;padding:clamp(64px,9vw,120px) 0">
  <div style="max-width:1240px;margin:0 auto;padding:0 clamp(20px,4vw,48px);display:flex;flex-wrap:wrap;gap:clamp(32px,5vw,80px);align-items:flex-start">
    <div style="flex:1 1 440px;min-width:0;display:flex;flex-direction:column;gap:18px"><span style="display:inline-flex;align-self:flex-start;padding:6px 12px;border-radius:999px;background:#CBB8FF;color:#0B0B0B;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;white-space:nowrap;">Verder dan marketing</span><h2 style="margin:0;font-size:clamp(30px,4vw,52px);font-weight:800;line-height:1.04;letter-spacing:-.03em;text-wrap:balance;">Vooraf weet je wat we gaan doen, waarom we het doen en welke <span style="background:linear-gradient(transparent 58%, #C5FF27 58%, #C5FF27 94%, transparent 94%);padding:0 .08em;-webkit-box-decoration-break:clone;box-decoration-break:clone">investering</span> daarbij hoort.</h2></div>
    <div style="flex:1 1 440px;min-width:0;display:flex;flex-direction:column;gap:18px;padding-top:8px">
      <p style="margin:0;font-size:17px;line-height:1.65;color:#3E3D39;text-wrap:pretty;">Daarom kijken we bij BDigital verder dan alleen je marketing. We onderzoeken je merk, je doelgroep, je commerciële resultaten en de processen achter je bedrijf. Daarbij combineren we jouw kennis van je onderneming met ons eigen onderzoek en onze expertise.</p>
      <p style="margin:0;font-size:17px;line-height:1.65;color:#3E3D39;text-wrap:pretty;">Op basis daarvan ontwikkelen we een concreet plan van aanpak. Geen losse diensten zonder samenhang, maar gerichte oplossingen die elkaar versterken.</p>
    </div>
  </div>
</section>

<section id="stap-1" data-screen-label="03 Stap 01" style="background:#FFFFFF;padding:clamp(64px,9vw,120px) 0;scroll-margin-top:70px">
  <div style="max-width:1240px;margin:0 auto;padding:0 clamp(20px,4vw,48px);display:flex;flex-direction:column;gap:clamp(32px,4vw,48px)">
    <div style="display:flex;align-items:center;gap:14px"><span style="font-size:clamp(44px,5vw,64px);font-weight:800;letter-spacing:-.05em;line-height:.9;color:transparent;-webkit-text-stroke:1.5px #0B0B0B">01</span><span style="height:1.5px;width:48px;background:#0B0B0B"></span><span style="display:inline-flex;align-self:flex-start;padding:6px 12px;border-radius:999px;background:#0B0B0B;color:#fff;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;white-space:nowrap;align-self:center">Stap 01</span></div>
    <div style="display:flex;flex-wrap:wrap;gap:clamp(32px,5vw,80px);align-items:flex-start">
      <div style="flex:1 1 440px;min-width:0;display:flex;flex-direction:column;gap:18px">
        <span style="font-size:13px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:#55544E">We brengen het volledige vraagstuk in kaart</span>
        <h2 style="margin:0;font-size:clamp(30px,4vw,52px);font-weight:800;line-height:1.04;letter-spacing:-.03em;text-wrap:balance;">Niet meteen oplossingen verkopen. Eerst de juiste vragen stellen.</h2>
        <p style="margin:0;font-size:17px;line-height:1.65;color:#3E3D39;text-wrap:pretty;">Geen bedrijf is hetzelfde. De ene organisatie wil meer kwalitatieve aanvragen, terwijl de andere moeite heeft om bestaande klanten goed op te volgen. Soms ligt het probleem niet bij de marketing, maar bij de processen die daarachter draaien.</p>
        <p style="margin:0;font-size:17px;line-height:1.65;color:#3E3D39;text-wrap:pretty;">Zo ontdekken we niet alleen waar verbeteringen mogelijk zijn, maar ook welke daarvan daadwerkelijk bijdragen aan jouw bedrijfsdoelen.</p>
      </div>
      <div style="flex:1 1 440px;min-width:0;display:flex;flex-direction:column;gap:14px">
        <p style="margin:0;font-size:17px;line-height:1.65;color:#0B0B0B;text-wrap:pretty;font-weight:700">We starten daarom met een kennismaking en een gericht onderzoek.</p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px">
          <div style="background:#FFB8D9;border-radius:20px;padding:24px;display:flex;flex-direction:column;gap:12px"><span style="font-size:12px;font-weight:800;letter-spacing:.16em;text-transform:uppercase">Jij vertelt ons</span><ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:10px;font-size:16px;font-weight:600;line-height:1.35"><li style="display:flex;gap:10px"><span style="flex:none;width:22px;height:22px;border-radius:50%;background:#0B0B0B;display:flex;align-items:center;justify-content:center;margin-top:1px"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#C5FF27" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10"></path></svg></span>waar je naartoe wilt</li><li style="display:flex;gap:10px"><span style="flex:none;width:22px;height:22px;border-radius:50%;background:#0B0B0B;display:flex;align-items:center;justify-content:center;margin-top:1px"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#C5FF27" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10"></path></svg></span>hoe je bedrijf werkt</li><li style="display:flex;gap:10px"><span style="flex:none;width:22px;height:22px;border-radius:50%;background:#0B0B0B;display:flex;align-items:center;justify-content:center;margin-top:1px"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#C5FF27" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10"></path></svg></span>waar je op dit moment tegenaan loopt</li></ul></div>
          <div style="background:#0B0B0B;color:#fff;border-radius:20px;padding:24px;display:flex;flex-direction:column;gap:12px"><span style="font-size:12px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;color:#C5FF27">Wij onderzoeken</span><ul style="margin:0;padding:0;list-style:none;display:flex;flex-direction:column;gap:10px;font-size:16px;font-weight:600;line-height:1.35"><li style="display:flex;gap:10px"><span style="flex:none;width:22px;height:22px;border-radius:50%;background:#C5FF27;display:flex;align-items:center;justify-content:center;margin-top:1px"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#0B0B0B" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10"></path></svg></span>je markt</li><li style="display:flex;gap:10px"><span style="flex:none;width:22px;height:22px;border-radius:50%;background:#C5FF27;display:flex;align-items:center;justify-content:center;margin-top:1px"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#0B0B0B" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10"></path></svg></span>je huidige resultaten</li><li style="display:flex;gap:10px"><span style="flex:none;width:22px;height:22px;border-radius:50%;background:#C5FF27;display:flex;align-items:center;justify-content:center;margin-top:1px"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#0B0B0B" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5 9-10"></path></svg></span>je digitale mogelijkheden</li></ul></div>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="stap-2" data-screen-label="04 Stap 02" style="background:#F4F1EA;padding:clamp(64px,9vw,120px) 0;scroll-margin-top:70px">
  <div style="max-width:1240px;margin:0 auto;padding:0 clamp(20px,4vw,48px);display:flex;flex-direction:column;gap:clamp(32px,4vw,48px)">
    <div style="display:flex;align-items:center;gap:14px"><span style="font-size:clamp(44px,5vw,64px);font-weight:800;letter-spacing:-.05em;line-height:.9;color:transparent;-webkit-text-stroke:1.5px #0B0B0B">02</span><span style="height:1.5px;width:48px;background:#0B0B0B"></span><span style="display:inline-flex;align-self:flex-start;padding:6px 12px;border-radius:999px;background:#0B0B0B;color:#fff;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;white-space:nowrap;align-self:center">Stap 02</span></div>
    <h2 style="margin:0;font-size:clamp(30px,4vw,52px);font-weight:800;line-height:1.04;letter-spacing:-.03em;text-wrap:balance;max-width:860px">Drie disciplines. <span style="background:linear-gradient(transparent 58%, #C5FF27 58%, #C5FF27 94%, transparent 94%);padding:0 .08em;-webkit-box-decoration-break:clone;box-decoration-break:clone">Eén samenhangende aanpak.</span></h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:16px">
      <article class="h5" style="background:#FFB8D9;border-radius:24px;padding:28px;display:flex;flex-direction:column;gap:14px;transition:transform .25s,box-shadow .25s"><div style="display:flex;align-items:center;justify-content:space-between"><span style="width:50px;height:50px;border-radius:15px;background:#0B0B0B;display:flex;align-items:center;justify-content:center"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FFB8D9" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20l4.5-1L19 8.5 15.5 5 5 15.5z"></path><path d="M13.5 7l3.5 3.5"></path></svg></span><span style="font-size:12px;font-weight:800;letter-spacing:.16em;text-transform:uppercase">Creatie</span></div><h3 style="margin:10px 0 0;font-size:24px;font-weight:800;line-height:1.12;letter-spacing:-.02em">Een sterk merk als fundament</h3><p style="margin:0;font-size:16px;line-height:1.6">We vertalen jouw verhaal naar een herkenbaar merk, een overtuigende uitstraling en middelen die je boodschap versterken. Van positionering en branding tot websites, content en campagneconcepten.</p><div style="margin-top:auto;padding-top:14px;border-top:1px solid rgba(11,11,11,.16);display:flex;flex-direction:column;gap:10px"><span style="font-size:11px;font-weight:800;letter-spacing:.16em;text-transform:uppercase">Diensten</span><div style="display:flex;flex-wrap:wrap;gap:6px"><span style="padding:5px 10px;border-radius:999px;background:rgba(255,255,255,.6);font-size:13px;font-weight:700;white-space:nowrap">Merkstrategie</span><span style="padding:5px 10px;border-radius:999px;background:rgba(255,255,255,.6);font-size:13px;font-weight:700;white-space:nowrap">Branding</span><span style="padding:5px 10px;border-radius:999px;background:rgba(255,255,255,.6);font-size:13px;font-weight:700;white-space:nowrap">Websites</span><span style="padding:5px 10px;border-radius:999px;background:rgba(255,255,255,.6);font-size:13px;font-weight:700;white-space:nowrap">Landingspagina’s</span><span style="padding:5px 10px;border-radius:999px;background:rgba(255,255,255,.6);font-size:13px;font-weight:700;white-space:nowrap">Grafisch ontwerp</span><span style="padding:5px 10px;border-radius:999px;background:rgba(255,255,255,.6);font-size:13px;font-weight:700;white-space:nowrap">Content en copywriting</span></div></div></article>
      <article class="h5" style="background:#C5FF27;border-radius:24px;padding:28px;display:flex;flex-direction:column;gap:14px;transition:transform .25s,box-shadow .25s"><div style="display:flex;align-items:center;justify-content:space-between"><span style="width:50px;height:50px;border-radius:15px;background:#0B0B0B;display:flex;align-items:center;justify-content:center"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#C5FF27" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10v4h3l6 4V6L7 10z"></path><path d="M16.5 9a4 4 0 0 1 0 6"></path><path d="M19 6.5a7.5 7.5 0 0 1 0 11"></path></svg></span><span style="font-size:12px;font-weight:800;letter-spacing:.16em;text-transform:uppercase">Marketing</span></div><h3 style="margin:10px 0 0;font-size:24px;font-weight:800;line-height:1.12;letter-spacing:-.02em">Van zichtbaarheid naar concrete resultaten</h3><p style="margin:0;font-size:16px;line-height:1.6">We brengen jouw merk bij de juiste doelgroep onder de aandacht, ontwikkelen campagnes en meten welke inspanningen bijdragen aan je doelen.</p><div style="margin-top:auto;padding-top:14px;border-top:1px solid rgba(11,11,11,.16);display:flex;flex-direction:column;gap:10px"><span style="font-size:11px;font-weight:800;letter-spacing:.16em;text-transform:uppercase">Diensten</span><div style="display:flex;flex-wrap:wrap;gap:6px"><span style="padding:5px 10px;border-radius:999px;background:rgba(255,255,255,.6);font-size:13px;font-weight:700;white-space:nowrap">Marketingstrategie</span><span style="padding:5px 10px;border-radius:999px;background:rgba(255,255,255,.6);font-size:13px;font-weight:700;white-space:nowrap">Online advertenties</span><span style="padding:5px 10px;border-radius:999px;background:rgba(255,255,255,.6);font-size:13px;font-weight:700;white-space:nowrap">SEO</span><span style="padding:5px 10px;border-radius:999px;background:rgba(255,255,255,.6);font-size:13px;font-weight:700;white-space:nowrap">Socialmediamarketing</span><span style="padding:5px 10px;border-radius:999px;background:rgba(255,255,255,.6);font-size:13px;font-weight:700;white-space:nowrap">Leadgeneratie</span><span style="padding:5px 10px;border-radius:999px;background:rgba(255,255,255,.6);font-size:13px;font-weight:700;white-space:nowrap">E-mailmarketing</span><span style="padding:5px 10px;border-radius:999px;background:rgba(255,255,255,.6);font-size:13px;font-weight:700;white-space:nowrap">Conversieoptimalisatie</span></div></div></article>
