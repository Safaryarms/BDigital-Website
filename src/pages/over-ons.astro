---
import Layout from '../layouts/Layout.astro';
import GhlFormEmbed from '../components/GhlFormEmbed.astro';
import Badge from '../components/Badge.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
---
<Layout title="Over ons — BDigital" description="Over BDigital: waarom we zijn ontstaan en hoe we de voorkant en achterkant van je marketing verbinden tot één werkend groeiproces." page="over">
<section data-screen-label="01 Hero over ons" style="background:#0B0B0B;color:#fff;position:relative;overflow:hidden">
  <div style="max-width:1240px;margin:0 auto;padding:clamp(48px,7vw,96px) clamp(20px,4vw,48px) clamp(64px,8vw,120px);display:flex;flex-wrap:wrap;gap:clamp(48px,6vw,88px);align-items:center">
    <div style="flex:1.2 1 460px;min-width:0;display:flex;flex-direction:column;gap:26px">
      <span style="align-self:flex-start;display:inline-flex;align-items:center;gap:10px;padding:7px 14px;border:1.5px solid #C5FF27;color:#C5FF27;border-radius:999px;font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;white-space:nowrap"><span style="width:7px;height:7px;border-radius:50%;background:#C5FF27"></span>Over ons</span>
      <h1 lang="nl" style="margin:0;font-size:clamp(40px,5.6vw,80px);line-height:.98;font-weight:800;letter-spacing:-.035em;text-wrap:balance">Wij zagen wat er mogelijk was. <span style="color:#C5FF27">En wat bedrijven lieten liggen.</span></h1>
      <p style="margin:0;font-size:17px;line-height:1.65;color:#C9C9C2;text-wrap:pretty;font-size:18px;max-width:560px">BDigital is ontstaan vanuit de overtuiging dat middelgrote bedrijven veel meer uit hun marketing en bedrijfsvoering kunnen halen.</p>
      <div style="display:flex;flex-wrap:wrap;gap:14px;align-items:center"><a class="h0" href="#intake" style="display:inline-flex;align-items:center;gap:10px;background:#C5FF27;color:#0B0B0B;font-weight:700;font-size:15px;padding:16px 24px;border-radius:999px;white-space:nowrap;transition:transform .2s">Maak kennis met BDigital <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"></path></svg></a><a class="h1" href="#kern" style="display:inline-flex;align-items:center;gap:10px;color:#fff;font-weight:700;font-size:15px;padding:15px 22px;border-radius:999px;border:1.5px solid #4A4A4A;white-space:nowrap;transition:border-color .2s">Onze kern</a></div>
    </div>
    <div style="flex:1 1 360px;min-width:0;display:flex;justify-content:center;padding:10px 20px 40px">
      <div style="position:relative;width:min(100%,400px);transform:rotate(3deg)">
        <div style="position:absolute;inset:8% -8% -6% 10%;background:#CBB8FF;border-radius:46% 54% 42% 58% / 52% 38% 62% 48%;transform:rotate(-3deg)"></div>
        <div style="position:relative;background:#fff;padding:14px 14px 60px;box-shadow:0 30px 60px rgba(0,0,0,.5);border-radius:4px">
          <div style="width:100%;aspect-ratio:4/4.6"><PhotoSlot id="over-hero-team" placeholder="Teamfoto of oprichters aan het werk" /></div>
          <span style="position:absolute;right:18px;bottom:20px;font-size:14px;font-weight:800;color:#0B0B0B">Team BDigital</span>
        </div>
        <span style="position:absolute;top:-14px;left:50%;transform:translateX(-50%) rotate(-4deg);width:120px;height:30px;background:#FFB8D9;opacity:.92"></span>
        <div style="position:absolute;left:-34px;bottom:-30px;transform:rotate(-7deg);background:#C5FF27;color:#0B0B0B;padding:16px 18px;width:190px;box-shadow:0 12px 28px rgba(0,0,0,.4);font-size:15px;font-weight:800;line-height:1.25">Wij vonden dat dit slimmer kon.</div>
      </div>
    </div>
  </div>
</section>

<section data-screen-label="02 Waarom ontstaan" style="background:#F4F1EA;padding:clamp(64px,9vw,120px) 0">
  <div style="max-width:1240px;margin:0 auto;padding:0 clamp(20px,4vw,48px);display:flex;flex-wrap:wrap;gap:clamp(32px,5vw,80px);align-items:flex-start">
    <div style="flex:1 1 420px;min-width:0;display:flex;flex-direction:column;gap:18px;position:sticky;top:100px"><span style="display:inline-flex;align-self:flex-start;padding:6px 12px;border-radius:999px;background:#CBB8FF;color:#0B0B0B;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;white-space:nowrap;">Waarom BDigital is ontstaan</span><h2 style="margin:0;font-size:clamp(30px,4vw,52px);font-weight:800;line-height:1.04;letter-spacing:-.03em;text-wrap:balance;">Meer resultaat. Minder verspilling. <span style="background:linear-gradient(transparent 58%, #C5FF27 58%, #C5FF27 94%, transparent 94%);padding:0 .08em;-webkit-box-decoration-break:clone;box-decoration-break:clone">Meer ruimte om te groeien.</span></h2></div>
    <div style="flex:1 1 460px;min-width:0;display:flex;flex-direction:column;gap:20px">
      <p style="margin:0;font-size:17px;line-height:1.65;color:#3E3D39;text-wrap:pretty;">Middelgrote bedrijven hebben vaak grote ambities, maar niet altijd de capaciteit om alles uit hun marketing en bedrijfsprocessen te halen. Campagnes draaien, content wordt gemaakt en nieuwe digitale tools worden aangeschaft. Toch blijft het beschikbare potentieel vaak onbenut.</p>
      <p style="margin:0;font-size:17px;line-height:1.65;color:#3E3D39;text-wrap:pretty;">Veel bedrijven blijven afhankelijk van traditionele marketingprocessen, losse systemen en handmatig werk. Dat kost niet alleen tijd, maar beperkt ook hun groeipotentieel.</p>
      <p style="margin:6px 0;font-size:clamp(22px,2.4vw,28px);font-weight:800;line-height:1.2;letter-spacing:-.02em">Wij brengen daar verandering in.</p>
      <p style="margin:0;font-size:17px;line-height:1.65;color:#3E3D39;text-wrap:pretty;">Daarom hebben we BDigital opgericht. Een partner die niet alleen zorgt dat jouw merk groeit, maar ook dat je bedrijf achter de schermen slimmer gaat werken.</p>
    </div>
  </div>
</section>

<section id="kern" data-screen-label="03 De kern" style="background:#FFFFFF;padding:clamp(64px,9vw,120px) 0;scroll-margin-top:70px">
  <div style="max-width:1240px;margin:0 auto;padding:0 clamp(20px,4vw,48px)">
    <div style="display:flex;flex-wrap:wrap;gap:24px 64px;align-items:flex-end">
      <div style="flex:1 1 520px;min-width:0;display:flex;flex-direction:column;gap:18px"><span style="display:inline-flex;align-self:flex-start;padding:6px 12px;border-radius:999px;background:#0B0B0B;color:#fff;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;white-space:nowrap;">De kern van BDigital</span><h2 style="margin:0;font-size:clamp(30px,4vw,52px);font-weight:800;line-height:1.04;letter-spacing:-.03em;text-wrap:balance;max-width:820px">Groei aan de voorkant. <span style="background:linear-gradient(transparent 58%, #CBB8FF 58%, #CBB8FF 94%, transparent 94%);padding:0 .08em;-webkit-box-decoration-break:clone;box-decoration-break:clone">Efficiëntie aan de achterkant.</span></h2></div>
      <p style="margin:0;font-size:17px;line-height:1.65;color:#3E3D39;text-wrap:pretty;flex:1 1 360px;max-width:460px">Wij combineren creativiteit en marketing met slimme technologie om niet alleen meer klanten binnen te halen, maar je bedrijf ook slimmer, schaalbaarder en winstgevender te maken.</p>
    </div>
    <div style="margin-top:clamp(36px,4vw,56px);display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:16px">
      <article class="h11" style="background:#C5FF27;border-radius:24px;padding:clamp(26px,3vw,40px);display:flex;flex-direction:column;gap:18px;position:relative;overflow:hidden;min-height:480px;transition:transform .25s">
        <span aria-hidden="true" style="position:absolute;right:-8px;top:-36px;font-size:190px;font-weight:800;letter-spacing:-.06em;line-height:1;color:rgba(11,11,11,.08)">01</span>
        <div style="display:flex;align-items:center;gap:12px;position:relative"><span style="width:52px;height:52px;border-radius:16px;background:#0B0B0B;display:flex;align-items:center;justify-content:center"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#C5FF27" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10v4h3l6 4V6L7 10z"></path><path d="M16.5 9a4 4 0 0 1 0 6"></path><path d="M19 6.5a7.5 7.5 0 0 1 0 11"></path></svg></span><span style="padding:6px 12px;border-radius:999px;background:#fff;font-size:11px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;white-space:nowrap">Voorkant</span></div>
        <h3 style="margin:8px 0 0;font-size:clamp(26px,2.8vw,36px);font-weight:800;line-height:1.05;letter-spacing:-.025em;position:relative">Meer halen uit je marketing</h3>
        <p style="margin:0;font-size:17px;line-height:1.6;font-weight:600;position:relative">Meer kwalitatieve content, meer campagnes en sneller optimaliseren. We combineren menselijke creativiteit met slimme technologie om marketing op te schalen zonder de kwaliteit uit het oog te verliezen.</p>
        <p style="margin:0;font-size:16px;line-height:1.6;position:relative">Aan de voorkant combineren we creatie, strategie en marketing om op grote schaal kwalitatieve content en campagnes te ontwikkelen.</p>
        <div style="margin-top:auto;display:flex;flex-wrap:wrap;gap:8px;position:relative"><span style="padding:7px 12px;border-radius:999px;background:rgba(255,255,255,.6);font-size:13px;font-weight:700">Meer snelheid</span><span style="padding:7px 12px;border-radius:999px;background:rgba(255,255,255,.6);font-size:13px;font-weight:700">Meer mogelijkheden om te testen</span><span style="padding:7px 12px;border-radius:999px;background:rgba(255,255,255,.6);font-size:13px;font-weight:700">Meer inzicht in wat resultaat oplevert</span></div>
      </article>
      <article class="h11" style="background:#CBB8FF;border-radius:24px;padding:clamp(26px,3vw,40px);display:flex;flex-direction:column;gap:18px;position:relative;overflow:hidden;min-height:480px;transition:transform .25s">
        <span aria-hidden="true" style="position:absolute;right:-8px;top:-36px;font-size:190px;font-weight:800;letter-spacing:-.06em;line-height:1;color:rgba(11,11,11,.08)">02</span>
        <div style="display:flex;align-items:center;gap:12px;position:relative"><span style="width:52px;height:52px;border-radius:16px;background:#0B0B0B;display:flex;align-items:center;justify-content:center"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#CBB8FF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12a8 8 0 1 1-2.6-5.9L20 8.5"></path><path d="M20 3.5v5h-5"></path></svg></span><span style="padding:6px 12px;border-radius:999px;background:#fff;font-size:11px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;white-space:nowrap">Achterkant</span></div>
        <h3 style="margin:8px 0 0;font-size:clamp(26px,2.8vw,36px);font-weight:800;line-height:1.05;letter-spacing:-.025em;position:relative">Meer overhouden door automatisering</h3>
        <p style="margin:0;font-size:17px;line-height:1.6;font-weight:600;position:relative">We onderzoeken waar je bedrijf onnodig tijd en geld verliest. Met slimme AI-integraties automatiseren we processen en bouwen we systemen die met je organisatie meegroeien.</p>
        <p style="margin:0;font-size:16px;line-height:1.6;position:relative">Aan de achterkant richten we bedrijfsprocessen efficiënter in. Van automatische leadopvolging tot, waar dat haalbaar is, het automatiseren van complete werkprocessen.</p>
        <div style="margin-top:auto;display:flex;flex-wrap:wrap;gap:8px;position:relative"><span style="padding:7px 12px;border-radius:999px;background:rgba(255,255,255,.6);font-size:13px;font-weight:700">Systemen verbinden</span><span style="padding:7px 12px;border-radius:999px;background:rgba(255,255,255,.6);font-size:13px;font-weight:700">Minder handmatig werk</span><span style="padding:7px 12px;border-radius:999px;background:rgba(255,255,255,.6);font-size:13px;font-weight:700">Lagere operationele kosten</span></div>
      </article>
    </div>
    <p style="margin:18px 0 0;font-size:13px;line-height:1.55;color:#6B6A64;max-width:760px">Of een werkproces volledig te automatiseren is, hangt af van bestaande systemen, datakwaliteit en de benodigde menselijke controles.</p>
  </div>
</section>

<section data-screen-label="04 Het resultaat" style="background:#0B0B0B;color:#fff;padding:clamp(64px,9vw,110px) 0">
  <div style="max-width:1240px;margin:0 auto;padding:0 clamp(20px,4vw,48px);display:flex;flex-direction:column;gap:clamp(36px,5vw,56px)">
    <div style="display:flex;flex-direction:column;gap:18px"><span style="display:inline-flex;align-self:flex-start;padding:6px 12px;border-radius:999px;background:transparent;color:#fff;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;white-space:nowrap;border:1.5px solid #fff">Het resultaat</span><h2 style="margin:0;font-size:clamp(30px,4vw,52px);font-weight:800;line-height:1.04;letter-spacing:-.03em;text-wrap:balance;">Het resultaat waar we <span style="color:#C5FF27">naartoe werken?</span></h2></div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:24px 0">
      <div style="padding:6px 28px 6px 24px;border-left:1px solid #2E2E2E;display:flex;flex-direction:column;gap:10px"><span style="font-size:13px;font-weight:800;letter-spacing:.14em;color:#C5FF27">01</span><span style="font-size:clamp(24px,2.4vw,32px);font-weight:800;letter-spacing:-.02em;line-height:1.1">Meer capaciteit</span><span style="font-size:16px;line-height:1.55;color:#C9C9C2">zonder dat je personeelsbestand even hard hoeft mee te groeien.</span></div>
      <div style="padding:6px 28px 6px 24px;border-left:1px solid #2E2E2E;display:flex;flex-direction:column;gap:10px"><span style="font-size:13px;font-weight:800;letter-spacing:.14em;color:#CBB8FF">02</span><span style="font-size:clamp(24px,2.4vw,32px);font-weight:800;letter-spacing:-.02em;line-height:1.1">Gezondere marges</span><span style="font-size:16px;line-height:1.55;color:#C9C9C2">doordat terugkerend werk en verspilling afnemen.</span></div>
      <div style="padding:6px 28px 6px 24px;border-left:1px solid #2E2E2E;display:flex;flex-direction:column;gap:10px"><span style="font-size:13px;font-weight:800;letter-spacing:.14em;color:#FFB8D9">03</span><span style="font-size:clamp(24px,2.4vw,32px);font-weight:800;letter-spacing:-.02em;line-height:1.1">Klaar voor de volgende stap</span><span style="font-size:16px;line-height:1.55;color:#C9C9C2">met een organisatie die kan meegroeien.</span></div>
    </div>
    <blockquote style="margin:0;background:#C5FF27;color:#0B0B0B;border-radius:24px;padding:clamp(26px,3.5vw,44px);display:flex;gap:20px;align-items:flex-start"><span aria-hidden="true" style="font-size:80px;line-height:.8;font-weight:800">“</span><p style="margin:0;font-size:clamp(22px,2.6vw,34px);line-height:1.2;font-weight:800;letter-spacing:-.02em;text-wrap:balance">Want groei gaat niet alleen over meer omzet. Het gaat ook over wat je onderaan de streep overhoudt.</p></blockquote>
  </div>
</section>

<section id="intake" data-screen-label="05 Kennismaken" style="background:#0B0B0B;color:#fff;padding:clamp(64px,9vw,120px) 0;scroll-margin-top:70px;position:relative;overflow:hidden">
  <div style="max-width:1240px;margin:0 auto;padding:0 clamp(20px,4vw,48px);display:flex;flex-wrap:wrap;gap:clamp(40px,5vw,80px);align-items:flex-start">
    <div style="flex:1 1 420px;min-width:0;display:flex;flex-direction:column;gap:24px">
      <h2 style="margin:0;font-size:clamp(32px,4vw,52px);font-weight:800;line-height:1.04;letter-spacing:-.03em;text-wrap:balance">Niet alleen een bureau dat je helpt groeien. <span style="color:#C5FF27">Een partner die ervoor zorgt dat je meer aan die groei overhoudt.</span></h2>
      <p style="margin:0;font-size:17px;line-height:1.65;color:#C9C9C2;max-width:520px;text-wrap:pretty">Met creativiteit en marketing helpen we bedrijven aan meer kwalitatieve zichtbaarheid en betere commerciële resultaten. Tegelijkertijd automatiseren we processen achter de schermen, zodat je efficiënter werkt en kunt groeien zonder dat je kosten even hard meestijgen.</p>
      <div style="display:flex;flex-wrap:wrap;gap:14px">
        <a class="h0" href="#intake-form" style="display:inline-flex;align-items:center;gap:10px;background:#C5FF27;color:#0B0B0B;font-weight:700;font-size:15px;padding:16px 24px;border-radius:999px;transition:transform .2s;white-space:nowrap">Maak kennis met BDigital <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"></path></svg></a>
        <a class="h1" href="#intake-form" style="display:inline-flex;align-items:center;gap:10px;color:#fff;font-weight:700;font-size:15px;padding:15px 22px;border-radius:999px;border:1.5px solid #4A4A4A;transition:border-color .2s;white-space:nowrap">Neem contact op</a>
      </div>
      <p style="margin:0;font-size:14px;color:#9E9E97;font-weight:500;max-width:480px">Een eerste gesprek is vrijblijvend. Je krijgt een eerlijk advies over wat wel en niet nodig is.</p>
      <div style="display:flex;flex-direction:column;gap:10px;font-size:15px;color:#E8E8E3">
        <a class="h9" href="mailto:hallo@bdigital.nl" style="display:flex;align-items:center;gap:12px"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="5" width="18" height="14" rx="2.5"></rect><path d="M3.5 7l8.5 6 8.5-6"></path></svg>hallo@bdigital.nl</a>
        <span style="display:flex;align-items:center;gap:12px"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"></path></svg>Gevestigd in [plaats]</span>
      </div>
      <div style="margin-top:12px;width:132px;height:132px;position:relative"><Badge /><img src="/assets/b-glyph.png" alt="" style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);height:30px;width:auto;mix-blend-mode:lighten"></div>
    </div>

    <GhlFormEmbed />
  </div>
</section>
</Layout>
